<?xml version="1.0" encoding="utf-8"?>
<!--
  A Git log, read left to right: a trunk carrying two commits, a branch that forks
  upward and ends in a third, and at the head of the trunk a wax seal.

  The seal is the point of the icon. Gits exists because `git -S` needs a key, so the
  commit at the end of history is not a plain disc but a stamped signature: vermilion
  wax with a hand-written stroke reversed out of it. A check would say "verified";
  a signature says "signed", which is what the app actually does for you.

  Everything circular here is placed by its *outer* edge, not its centre. A launcher
  shows the middle 72dp, and a round one shows a circle of radius 36, so a node whose
  centre is still inside can be shaved by the mask into a crescent that reads as a
  chip out of the disc. Measuring the rim keeps the whole of every node and of the
  seal inside that circle; the strokes are then free to reach for the corners, which
  is what a bleeding line is supposed to look like.

  There is no rim around the seal. A ring outside a fourteen-unit disc either runs
  into the mask or lands one unit from a commit, and at launcher size a ring that
  tight is a sub-pixel smudge that says nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The trunk, and the branch that forks off it. -->
    <path
        android:pathData="M29,64 L72,64"
        android:strokeColor="#232019"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M47,64 L47,40 L60,40"
        android:strokeColor="#232019"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The three commits: two on the trunk, one on the branch. -->
    <path
        android:pathData="M29,64 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0"
        android:fillColor="#232019" />
    <path
        android:pathData="M47,64 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0"
        android:fillColor="#232019" />
    <path
        android:pathData="M60,40 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0"
        android:fillColor="#232019" />

    <!-- The signed head of history: wax, then the signature written across it. -->
    <path
        android:pathData="M72,64 m-14,0 a14,14 0,1 1,28 0 a14,14 0,1 1,-28 0"
        android:fillColor="#A62B22" />
    <!--
      The signature is an S, for `git -S`: the command that needs the key this app
      holds. It is one stroke, so the letter is measured rather than drawn. The disc
      is twenty-eight units across and the top arc, the spine and the foot all have
      to stack inside it, which leaves them 2.8 to 3.0 units apart at the middle -
      1.3px at the 48dp a launcher actually draws - and any tighter and the counters
      fill in and the S collapses into a blob. Every point of the centreline is kept
      1.8 units inside the rim, so the stroke's own edge never reaches the wax and
      the letter stays a letter against the disc it is stamped in.
    -->
    <path
        android:pathData="M77.5,56 C77.2,52.1 66,52.6 65.5,57.8 C65.5,62.5 78.5,56 78.5,62.3 C78.5,65.5 72,66.4 66,63.8"
        android:strokeColor="#F0E8D8"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!--
      The rule the signature sits on. The stroke on its own is only a flourish, and
      a flourish stamped in wax could be anything; writing above a straight line is
      read as a signature without having to be legible. It is the same weight as the
      writing, so the two read as one pen, and kept 3.7 units clear of the lowest
      stroke so the gap survives downscaling instead of the two fusing into a blob:
      1.6px at the 48dp a launcher actually draws.
    -->
    <path
        android:pathData="M65,72 L79,72"
        android:strokeColor="#F0E8D8"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
