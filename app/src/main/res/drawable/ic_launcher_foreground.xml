<?xml version="1.0" encoding="utf-8"?>
<!--
  A Git commit graph, in the diagonal form GitHub uses: two commits that merge and
  then carry on together, drawn as a "Y" rather than a box-and-line tree.

  The tip of the trunk is a green disc with a check, which is the one thing this app
  does that a plain Git client does not: decide for itself whether a signature is
  good. A disc is used rather than a ring because the fill survives being seen at
  fifteen pixels.

  Everything circular here is placed by its *outer* edge, not its centre. A launcher
  shows the middle 72dp, and a round one shows a circle of radius 36, so a node whose
  centre is still inside can be shaved by the mask into a crescent that reads as a
  chip out of the disc. Measuring the rim keeps the whole of every node and of the
  seal inside that circle; the strokes are then free to reach for the corners, which
  is what a bleeding line is supposed to look like.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The two commits that merge, and the trunk that leaves the merge. -->
    <path
        android:pathData="M35,35 L52,52 L67,67"
        android:strokeColor="#F05032"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M70,36 L52,52"
        android:strokeColor="#F05032"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The upper commits. -->
    <path
        android:pathData="M35,35 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0"
        android:fillColor="#E5E7EB" />
    <path
        android:pathData="M70,36 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0"
        android:fillColor="#E5E7EB" />
    <!-- The merge. -->
    <path
        android:pathData="M52,52 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0"
        android:fillColor="#E5E7EB" />

    <!-- The seal, drawn around the tip of the trunk it covers. -->
    <path
        android:pathData="M67,67 m-14,0 a14,14 0,1 1,28 0 a14,14 0,1 1,-28 0"
        android:fillColor="#22C55E" />
    <!-- Rim outside the disc rather than a ring inside it: an inset ring on a
         fourteen-unit disc is a sub-pixel smudge at launcher size, and says nothing. -->
    <path
        android:pathData="M67,67 m-15,0 a15,15 0,1 1,30 0 a15,15 0,1 1,-30 0"
        android:strokeColor="#E5E7EB"
        android:strokeWidth="2" />
    <path
        android:pathData="M60,68 L64.5,73 L74,61"
        android:strokeColor="#0B1220"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
